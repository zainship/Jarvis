rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation helpers
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidChatMessage(data, userId) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == userId &&
             data.sender is string && (data.sender == 'user' || data.sender == 'jarvis' || data.sender == 'system') &&
             data.text is string && data.text.size() <= 5000 &&
             data.timestamp is string && data.timestamp.size() <= 128 &&
             (!('isVoiceInput' in data) || data.isVoiceInput is bool) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidResearchDossier(data, userId) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == userId &&
             data.topic is string && data.topic.size() <= 256 &&
             data.title is string && data.title.size() <= 256 &&
             data.executiveSummary is string && data.executiveSummary.size() <= 10000 &&
             (!('dossierJson' in data) || (data.dossierJson is string && data.dossierJson.size() <= 50000)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidProductivityTask(data, userId) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() <= 256 &&
             data.category is string && (data.category == 'work' || data.category == 'research' || data.category == 'automation' || data.category == 'personal') &&
             data.priority is string && (data.priority == 'high' || data.priority == 'medium' || data.priority == 'low') &&
             data.completed is bool &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidBrowserWorkflow(data, userId) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == userId &&
             data.workflowName is string && data.workflowName.size() <= 256 &&
             data.targetWebsite is string && data.targetWebsite.size() <= 256 &&
             data.status is string && (data.status == 'pending' || data.status == 'running' || data.status == 'completed' || data.status == 'failed') &&
             (!('summaryTitle' in data) || (data.summaryTitle is string && data.summaryTitle.size() <= 512)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidVoiceSettings(data, userId) {
      return data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.pitch is number && data.pitch >= 0.1 && data.pitch <= 3.0 &&
             data.rate is number && data.rate >= 0.1 && data.rate <= 3.0 &&
             (!('voiceURI' in data) || (data.voiceURI is string && data.voiceURI.size() <= 512)) &&
             (!('presetName' in data) || (data.presetName is string && data.presetName.size() <= 128)) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 32)) &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User root collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // No blanket listing of user profiles
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      // User chat messages
      match /messages/{messageId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId) &&
                      incoming().id == existing().id &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      // User research dossiers
      match /research_dossiers/{dossierId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(dossierId) && isValidResearchDossier(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(dossierId) && isValidResearchDossier(incoming(), userId) &&
                      incoming().id == existing().id &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(dossierId);
      }

      // User productivity tasks
      match /tasks/{taskId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidProductivityTask(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(taskId) && isValidProductivityTask(incoming(), userId) &&
                      incoming().id == existing().id &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // User browser workflows
      match /browser_workflows/{workflowId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workflowId) && isValidBrowserWorkflow(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(workflowId) && isValidBrowserWorkflow(incoming(), userId) &&
                      incoming().id == existing().id &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(workflowId);
      }

      // User configuration & voice settings
      match /settings/{settingId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(settingId) && isValidVoiceSettings(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(settingId) && isValidVoiceSettings(incoming(), userId) &&
                      incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(settingId);
      }
    }
  }
}
